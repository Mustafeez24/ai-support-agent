# Copy this file to .env and fill in real values. Never commit .env.

# --- NVIDIA LLM (OpenAI-compatible endpoint) ---
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY_HERE
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- Dataset / development ---
# Leave DATA_SAMPLE_SIZE unset (or 0) to process the full CSV.
# Set it to a small number (e.g. 100000) for fast local iteration.
DATA_SAMPLE_SIZE=0
RANDOM_SEED=42

# --- Brand ---
BRAND_NAME=AmazonHelp
BRAND_AUTHOR_ID=AmazonHelp
